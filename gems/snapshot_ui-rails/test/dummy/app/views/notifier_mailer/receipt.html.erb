<div style="font-family: -apple-system, system-ui, sans-serif; max-width: 560px; margin: 0 auto; color: #1f2937;">
  <div style="background: #4f46e5; color: #fff; padding: 24px 28px; border-radius: 12px 12px 0 0;">
    <h1 style="margin: 0; font-size: 20px;">Order confirmed 🌱</h1>
    <p style="margin: 6px 0 0; opacity: .85;">Thanks for supporting your local garden.</p>
  </div>
  <div style="border: 1px solid #e5e7eb; border-top: 0; border-radius: 0 0 12px 12px; padding: 24px 28px;">
    <p>Hi Ada, your order <strong><%= @order[:id] %></strong> is on its way.</p>
    <table style="width: 100%; border-collapse: collapse; margin: 16px 0;">
      <% @order[:items].each do |name, price| %>
        <tr><td style="padding: 8px 0; border-bottom: 1px solid #f3f4f6;"><%= name %></td>
            <td style="padding: 8px 0; border-bottom: 1px solid #f3f4f6; text-align: right;"><%= price %></td></tr>
      <% end %>
      <tr><td style="padding: 12px 0; font-weight: 700;">Total</td>
          <td style="padding: 12px 0; font-weight: 700; text-align: right;"><%= @order[:total] %></td></tr>
    </table>
    <a href="https://example.test/orders/<%= @order[:id] %>" style="display: inline-block; background: #4f46e5; color: #fff; padding: 10px 20px; border-radius: 8px; text-decoration: none;">View order</a>
  </div>
</div>
