<div style="margin:0; background:#f2f6f2; padding:24px; font-family:-apple-system,'Segoe UI',system-ui,sans-serif; color:#1f2937;">
  <div style="max-width:520px; margin:0 auto; background:#ffffff; border-radius:14px; overflow:hidden; box-shadow:0 1px 3px rgba(0,0,0,.06);">
    <div style="background:#166534; background-image:linear-gradient(135deg,#166534,#15803d); padding:28px 32px; color:#ffffff;">
      <div style="font-size:28px; line-height:1;">🌱</div>
      <h1 style="margin:12px 0 2px; font-size:22px; font-weight:700;">Welcome, <%= @name %>!</h1>
      <p style="margin:0; opacity:.9; font-size:14px;">You're on the list for the Fernwood Community Garden.</p>
    </div>

    <div style="padding:28px 32px;">
      <p style="margin:0 0 16px; font-size:15px; line-height:1.6;">
        Thanks for joining our urban gardening community. A plot opens up roughly every few weeks — here's what's
        coming up near you:
      </p>

      <table role="presentation" width="100%" style="border-collapse:collapse; margin:0 0 20px;">
        <tr>
          <td style="padding:12px 14px; border:1px solid #e5e7eb; border-radius:10px 10px 0 0; font-size:14px;">
            🥕 <strong>Raised bed A3</strong> — full sun, 2×1m<br>
            <span style="color:#6b7280;">Available from April</span>
          </td>
        </tr>
        <tr>
          <td style="padding:12px 14px; border:1px solid #e5e7eb; border-top:0; border-radius:0 0 10px 10px; font-size:14px;">
            🌿 <strong>Herb corner H1</strong> — partial shade, 1×1m<br>
            <span style="color:#6b7280;">Available from May</span>
          </td>
        </tr>
      </table>

      <a href="https://example.test/plots" style="display:inline-block; background:#15803d; color:#ffffff; padding:11px 22px; border-radius:8px; text-decoration:none; font-weight:600; font-size:14px;">
        Browse available plots →
      </a>

      <p style="margin:24px 0 0; font-size:13px; color:#9ca3af;">
        Happy planting,<br>The Fernwood Garden team
      </p>
    </div>
  </div>
</div>
